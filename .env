# Уже заполненный и закоммитченный файл окружения — копировать/заполнять
# перед запуском не нужно. Тестовый стенд: везде, где логин/пароль
# настраиваемы, используем admin / password (не переусложняем).

# MSSQL: пользователь фиксированный системный "sa" (переименовать нельзя),
# пароль не может быть буквально "password" — MSSQL требует длину >= 8 и
# символы минимум 3 из 4 категорий (строчные/прописные/цифры/спецсимволы).
MSSQL_SA_PASSWORD=AdminPassword1!

# Oracle: SYS/SYSTEM (системные, фиксированные) — пароль password.
ORACLE_PASSWORD=password
# Oracle: пользователь-схема demo (бизнес-схема данных, имя сознательно оставлено demo) — пароль password.
ORACLE_APP_PASSWORD=password

PG_CATALOG_USER=admin
PG_CATALOG_PASSWORD=password

AIRFLOW_PG_USER=admin
AIRFLOW_PG_PASSWORD=password
AIRFLOW_UI_USER=admin
AIRFLOW_UI_PASSWORD=password

SILO_ROOT_USER=admin
SILO_ROOT_PASSWORD=password

AIRFLOW_FERNET_KEY=
