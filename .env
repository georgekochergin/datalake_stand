# Уже заполненный и закоммитченный файл окружения — копировать/заполнять
# перед запуском не нужно. Тестовый стенд: везде, где логин/пароль
# настраиваемы, используем admin / admin (не переусложняем).

# MSSQL: системный логин "sa" (переименовать нельзя) — для bootstrap контейнера
# пароль должен быть сильным (длина >= 8 и минимум 3 из 4 категорий символов).
# Для доступа из DBeaver/приложений datagen-api дополнительно создаёт логин
# admin / admin (sysadmin) — см. datagen-api/app/provisioning.py.
MSSQL_SA_PASSWORD=AdminPassword1!

# Oracle: SYS/SYSTEM (системные, фиксированные) — пароль admin.
ORACLE_PASSWORD=admin
# Oracle: пользователь-схема demo (бизнес-схема данных, имя сознательно оставлено demo) — пароль admin.
ORACLE_APP_PASSWORD=admin

PG_CATALOG_USER=admin
PG_CATALOG_PASSWORD=admin

AIRFLOW_PG_USER=admin
AIRFLOW_PG_PASSWORD=admin
AIRFLOW_UI_USER=admin
AIRFLOW_UI_PASSWORD=admin

SILO_ROOT_USER=admin
# MinIO/SILO требует пароль не короче 8 символов, поэтому здесь не буквально
# "admin", а минимально короткий admin123 (единственное исключение из admin/admin).
SILO_ROOT_PASSWORD=admin123

AIRFLOW_FERNET_KEY=
