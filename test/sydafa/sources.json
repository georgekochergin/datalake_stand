    "db2": {
      "type": "mssql",
      "external_port": 14330,
      "schema": {
        "tables": {
          "demo.customers": {
            "primary_key": [
              "customer_id"
            ],
            "columns": {
              "customer_id": "bigint",
              "name": "string",
              "segment": "string"
            },
            "foreign_keys": []
          },
          "demo.products": {
            "primary_key": [
              "product_id"
            ],
            "columns": {
              "product_id": "bigint",
              "product_name": "string",
              "price": "decimal(18,2)"
            },
            "foreign_keys": []
          },
          "demo.orders": {
            "primary_key": [
              "order_id"
            ],
            "columns": {
              "order_id": "bigint",
              "customer_id": "bigint",
              "product_id": "bigint",
              "amount": "decimal(18,2)",
              "order_date": "date"
            },
            "foreign_keys": [
              {
                "columns": [
                  "customer_id"
                ],
                "ref_entity_fqn": "demo.customers",
                "ref_columns": [
                  "customer_id"
                ]
              },
              {
                "columns": [
                  "product_id"
                ],
                "ref_entity_fqn": "demo.products",
                "ref_columns": [
                  "product_id"
                ]
              }
            ]
          }
        }
      },
      "rules": {
        "demo.customers": {
          "columns": {
            "customer_id": {
              "kind": "sequence"
            },
            "name": {
              "kind": "faker",
              "provider": "company"
            },
            "segment": {
              "kind": "choice",
              "values": [
                "Retail",
                "Corporate",
                "VIP"
              ]
            }
          }
        },
        "demo.products": {
          "columns": {
            "product_id": {
              "kind": "sequence"
            },
            "product_name": {
              "kind": "faker",
              "provider": "word"
            },
            "price": {
              "kind": "random_decimal",
              "min": 1,
              "max": 100000
            }
          }
        },
        "demo.orders": {
          "columns": {
            "order_id": {
              "kind": "sequence"
            },
            "amount": {
              "kind": "random_decimal",
              "min": 1,
              "max": 100000
            },
            "order_date": {
              "kind": "random_date"
            }
          }
        }
