__pycache__/
*.pyc
.venv/
*.log
.DS_Store

# Пользовательский код стенда (каркас каталогов удерживается через .gitkeep)
/airflow/*
!/airflow/.gitkeep
!/airflow/.airflowignore
!/airflow/dags/
!/airflow/dags/**
!/airflow/migrations/
!/airflow/migrations/**
!/airflow/plugins/
!/airflow/plugins/**

# Сгенерированные DAG-и (артефакт ingestion/generate_dags.py)
airflow/dags/generated/
airflow/dags/generated/**

# Исключаем временные файлы Python везде
**/__pycache__/**
**/*.pyc

# Временное дерево проекта для e2e-тестов
test/.workspace/
test/.workspace/**

/trino/*
!/trino/.gitkeep

# Граф кодовой базы graphify: в git — только сам граф.
# graph.json самодостаточен для запросов (имена сообществ записаны в узлах);
# остальное — кэш пересборок и производные артефакты (см. docs/graphify.md)
graphify-out/*
!graphify-out/graph.json

# Сессионные планы приложения ZCode — машинно-локальные; спек-скиллы
# в .zcode/skills/ коммитятся (см. docs/speckit.md)
.zcode/plans/
