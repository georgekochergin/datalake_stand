__pycache__/
*.pyc
.venv/
*.log
.DS_Store

# Пользовательский код стенда (каркас каталогов удерживается через .gitkeep)
/airflow/*
!/airflow/.gitkeep
!/airflow/dags/
!/airflow/dags/**
!/airflow/migrations/
!/airflow/migrations/**
!/airflow/plugins/
!/airflow/plugins/**

# Исключаем временные файлы Python везде
**/__pycache__/**
**/*.pyc

# Временное дерево проекта для e2e-тестов
test/.workspace/
test/.workspace/**

/spark/*
!/spark/.gitkeep
!/spark/raw/
!/spark/raw/**
/spark/raw/**/__pycache__/
/spark/raw/**/*.pyc

/trino/*
!/trino/.gitkeep
